# Copy to .env and adjust. .env is gitignored; this file is not.
# Never commit real secrets.

POSTGRES_USER=bootcamp
POSTGRES_PASSWORD=bootcamp
POSTGRES_DB=bootcamp_connect
DATABASE_URL=postgresql+asyncpg://bootcamp:bootcamp@db:5432/bootcamp_connect

# Signs nothing at runtime (sessions are opaque tokens stored in Postgres)
# but rotate it if you ever add signed cookies. Required, no safe default.
SESSION_SECRET=change-me

# Password for the five seeded admin accounts. Required by seed.py — there is
# deliberately no hardcoded fallback. See specs/02_registration_and_login.md §7.
SEED_ADMIN_PASSWORD=bootcamp-dev-admin

MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Test database. Integration tests wipe this between runs.
TEST_DATABASE_URL=postgresql+asyncpg://bootcamp:bootcamp@db:5432/bootcamp_connect_test