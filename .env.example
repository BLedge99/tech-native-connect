# Copy to .env and adjust. .env is gitignored; this file is not.
# Never commit real secrets.

POSTGRES_USER=bootcamp
POSTGRES_PASSWORD=bootcamp
POSTGRES_DB=bootcamp_connect
DATABASE_URL=postgresql+asyncpg://bootcamp:bootcamp@db:5432/bootcamp_connect

# Password for the five seeded admin accounts. Required by seed.py — there is
# deliberately no hardcoded fallback. See specs/02_registration_and_login.md §7.
SEED_ADMIN_PASSWORD=bootcamp-dev-admin

MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025

APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# The BROWSER's origin, not the API's. Magic-link emails and the post-verify
# redirect point here; the API port would land the user on a 404.
APP_URL=http://localhost:5173

# Test database. Integration tests wipe this between runs.
TEST_DATABASE_URL=postgresql+asyncpg://bootcamp:bootcamp@db:5432/bootcamp_connect_test

# Demo/free deployments have no mail provider. On, the magic-link endpoint
# returns the sign-in link in the API response (only for real accounts) and
# the sign-in page renders it inline. Off everywhere by default: with it on,
# the always-202 contract stops hiding which emails have accounts.
# See decisions/0013-demo-expose-magic-links.md.
DEMO_EXPOSE_MAGIC_LINKS=true

# Cloudflare Tunnel (optional). Leave empty to use free automatic Quick Tunnel (*.trycloudflare.com).
# If you have a named Cloudflare Tunnel, provide your tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=